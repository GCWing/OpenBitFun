MARKET_PUBLIC_BASE_URL=https://market.example.com/miniapp
# Unified GitHub sign-in callback. Leave empty to derive it from the public base.
MARKET_GITHUB_CALLBACK_URL=https://auth.example.com/api/v1/auth/github/callback
MARKET_PUBLIC_BROWSE=false
# Keep browser-based submission writes disabled. OpenBitFun Desktop uses Bearer auth and remains enabled.
MARKET_WEB_SUBMISSIONS_ENABLED=false
MARKET_GITHUB_CLIENT_ID=
MARKET_GITHUB_CLIENT_SECRET=
MARKET_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Comma-separated numeric GitHub IDs allowed to administer the market.
# Empty means no administrator until this deployment sets its own IDs.
MARKET_ADMIN_GITHUB_IDS=
RUST_LOG=openbitfun_miniapp_market=info,tower_http=info

# Optional email-code sign-in. Production stores these in a separate root-only smtp.env.
# SMTP_HOST=smtp.qiye.aliyun.com
# SMTP_PORT=465
# SMTP_SECURITY=ssl
# SMTP_USERNAME=hello@example.com
# SMTP_PASSWORD=
# SMTP_FROM_NAME=OpenBitFun
