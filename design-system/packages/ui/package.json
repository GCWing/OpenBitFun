{
  "name": "@openbitfun/ui",
  "version": "0.1.0",
  "description": "Theme-independent React components for OpenBitFun product surfaces",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/types/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./brand": {
      "types": "./dist/types/brand.d.ts",
      "import": "./dist/brand.js"
    },
    "./flow-chat": {
      "types": "./dist/types/flow-chat.d.ts",
      "import": "./dist/flow-chat.js"
    },
    "./mobile": {
      "types": "./dist/types/mobile.d.ts",
      "import": "./dist/mobile.js"
    },
    "./mobile.css": "./dist/mobile.css",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.mobile.config.ts && tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@openbitfun/design-tokens": "workspace:^",
    "lucide-react": "^0.560.0"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
