{
  "name": "@openbitfun/design-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone authoring and preview application for the OpenBitFun design system",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4178 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "test": "node --test vite/*.test.mjs && pnpm run type-check",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@openbitfun/flow-chat-presentation": "workspace:*",
    "@openbitfun/design-tokens": "workspace:^",
    "@openbitfun/theme-openbitfun": "workspace:^",
    "@openbitfun/ui": "workspace:^",
    "lucide-react": "^0.560.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@openbitfun/token-engine": "workspace:*",
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
