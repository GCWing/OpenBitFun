# syntax=docker/dockerfile:1

# Build one multi-platform runtime image from the two signed Relay archives
# produced by linux-binaries.yml.  The archives are built on Ubuntu 22.04 and
# carry an asserted glibc <= 2.35 floor; trixie is intentionally kept as the
# runtime base because older Relay releases in the wild required glibc 2.38.
FROM debian:trixie-slim AS payload

ARG TARGETARCH
WORKDIR /payload
COPY openbitfun-relay-server-*.tar.gz /tmp/relay/

RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) target=x86_64-unknown-linux-gnu ;; \
      arm64) target=aarch64-unknown-linux-gnu ;; \
      *) echo "Unsupported Relay image architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    archive="/tmp/relay/openbitfun-relay-server-${target}.tar.gz"; \
    test -f "${archive}"; \
    tar -xzf "${archive}" --strip-components=1; \
    test -x openbitfun-relay-server; \
    test -x relay-admin; \
    test -f static/index.html

FROM debian:trixie-slim

ARG VERSION
ARG REVISION
LABEL org.opencontainers.image.title="OpenBitFun Relay Server" \
      org.opencontainers.image.description="Self-hosted relay server for OpenBitFun" \
      org.opencontainers.image.source="https://github.com/openBitFun/OpenBitFun" \
      org.opencontainers.image.url="https://github.com/openBitFun/OpenBitFun" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.licenses="MIT"

ENV DEBIAN_FRONTEND=noninteractive
RUN set -eux; \
    apt-get -o Acquire::Retries=3 update; \
    apt-get install -y --no-install-recommends ca-certificates curl; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=payload /payload/openbitfun-relay-server /payload/relay-admin /app/
COPY --from=payload /payload/static /app/static

RUN set -eu; \
    chmod 755 /app/openbitfun-relay-server /app/relay-admin; \
    mkdir -p /app/data /app/room-web; \
    for bin in /app/openbitfun-relay-server /app/relay-admin; do \
      out="$(ldd "$bin" 2>&1)"; \
      printf '%s\n' "$out"; \
      case "$out" in \
        *"not found"*) echo "ERROR: $bin cannot be loaded by this runtime image." >&2; exit 1 ;; \
      esac; \
    done

VOLUME ["/app/data", "/app/room-web"]
EXPOSE 9700
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD curl -fsS "http://127.0.0.1:${RELAY_PORT:-9700}/health" || exit 1

CMD ["/app/openbitfun-relay-server"]
