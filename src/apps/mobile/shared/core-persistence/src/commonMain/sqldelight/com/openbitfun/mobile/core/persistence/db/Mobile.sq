CREATE TABLE chat_session (
    session_id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    agent_type TEXT NOT NULL,
    status TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    created_at TEXT NOT NULL,
    message_count INTEGER NOT NULL,
    workspace_path TEXT,
    workspace_name TEXT,
    pinned INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE chat_message (
    message_id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL,
    role TEXT NOT NULL,
    text TEXT NOT NULL,
    status TEXT NOT NULL,
    timestamp TEXT,
    thinking TEXT,
    payload_json TEXT NOT NULL
);

CREATE INDEX chat_message_session_index ON chat_message(session_id);

CREATE TABLE chat_draft (
    draft_id TEXT NOT NULL PRIMARY KEY,
    text TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

selectSessions:
SELECT * FROM chat_session ORDER BY updated_at DESC;

selectSessionsByAgent:
SELECT * FROM chat_session WHERE agent_type = ? ORDER BY updated_at DESC;

selectSession:
SELECT * FROM chat_session WHERE session_id = ?;

selectMessages:
SELECT * FROM chat_message WHERE session_id = ? ORDER BY timestamp ASC, message_id ASC;

deleteSession:
DELETE FROM chat_session WHERE session_id = ?;

deleteMessagesForSession:
DELETE FROM chat_message WHERE session_id = ?;

upsertSession:
INSERT OR REPLACE INTO chat_session(
    session_id, title, agent_type, status, updated_at, created_at, message_count,
    workspace_path, workspace_name, pinned
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Pinning is exclusive per kind, so clearing the old one and setting the new one
-- happen together or not at all; see ChatLocalStore.pinSession.
clearPinnedSessions:
UPDATE chat_session SET pinned = 0 WHERE agent_type = ? AND pinned = 1;

setPinnedSession:
UPDATE chat_session SET pinned = 1 WHERE session_id = ?;

setSessionStatus:
UPDATE chat_session SET status = ? WHERE session_id = ?;

upsertMessage:
INSERT OR REPLACE INTO chat_message(
    message_id, session_id, role, text, status, timestamp, thinking, payload_json
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectDraft:
SELECT * FROM chat_draft WHERE draft_id = ?;

upsertDraft:
INSERT OR REPLACE INTO chat_draft(draft_id, text, updated_at) VALUES (?, ?, ?);

deleteDraft:
DELETE FROM chat_draft WHERE draft_id = ?;

-- Owning workspace columns: NULL in all four means a pre-identity row; a non-NULL
-- workspace_identity_path with NULL id/connection/host is an explicit local workspace.
CREATE TABLE remote_session_list (
    device_key TEXT NOT NULL,
    session_id TEXT NOT NULL,
    title TEXT NOT NULL,
    agent_type TEXT NOT NULL,
    status TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    created_at TEXT NOT NULL,
    message_count INTEGER NOT NULL,
    last_message_id TEXT NOT NULL,
    workspace_path TEXT,
    workspace_name TEXT,
    has_more INTEGER NOT NULL DEFAULT 0,
    pending_confirmed INTEGER NOT NULL DEFAULT 0,
    workspace_identity_path TEXT,
    workspace_id TEXT,
    remote_connection_id TEXT,
    remote_ssh_host TEXT,
    PRIMARY KEY (device_key, session_id)
);

CREATE INDEX remote_session_list_device_updated_index
ON remote_session_list(device_key, updated_at DESC);

CREATE TABLE remote_session_message (
    device_key TEXT NOT NULL,
    session_id TEXT NOT NULL,
    seq INTEGER NOT NULL,
    message_id TEXT NOT NULL,
    role TEXT NOT NULL,
    text TEXT NOT NULL,
    status TEXT NOT NULL,
    timestamp TEXT,
    thinking TEXT,
    payload_json TEXT NOT NULL,
    PRIMARY KEY (device_key, session_id, seq)
);

CREATE INDEX remote_session_message_device_session_index
ON remote_session_message(device_key, session_id, seq);

CREATE TABLE remote_session_cursor (
    device_key TEXT NOT NULL,
    session_id TEXT NOT NULL,
    poll_version TEXT NOT NULL DEFAULT '',
    known_message_count INTEGER NOT NULL DEFAULT 0,
    known_model_catalog_version TEXT NOT NULL DEFAULT '',
    PRIMARY KEY (device_key, session_id)
);

-- One row per workspace the device serves. Rows are identified by workspace_id
-- when the host provided one and by (remote_connection_id, remote_ssh_host, path)
-- otherwise, so the same path may appear more than once per device. The writer
-- rewrites a device's rows as a whole in seq order.
CREATE TABLE remote_workspace_list (
    device_key TEXT NOT NULL,
    path TEXT NOT NULL,
    name TEXT NOT NULL,
    last_opened TEXT NOT NULL,
    workspace_kind TEXT NOT NULL,
    seq INTEGER NOT NULL,
    workspace_id TEXT,
    remote_connection_id TEXT,
    remote_ssh_host TEXT
);

CREATE INDEX remote_workspace_list_device_seq_index ON remote_workspace_list(device_key, seq);

selectRemoteSessions:
SELECT * FROM remote_session_list WHERE device_key = ? ORDER BY updated_at DESC, session_id ASC;

upsertRemoteSession:
INSERT OR REPLACE INTO remote_session_list(device_key, session_id, title, agent_type, status, updated_at, created_at, message_count, last_message_id, workspace_path, workspace_name, has_more, pending_confirmed, workspace_identity_path, workspace_id, remote_connection_id, remote_ssh_host)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteRemoteSessionsForDevice:
DELETE FROM remote_session_list WHERE device_key = ?;

selectRemoteMessages:
SELECT * FROM remote_session_message WHERE device_key = ? AND session_id = ? ORDER BY seq ASC;

upsertRemoteMessage:
INSERT OR REPLACE INTO remote_session_message(device_key, session_id, seq, message_id, role, text, status, timestamp, thinking, payload_json)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteRemoteMessages:
DELETE FROM remote_session_message WHERE device_key = ? AND session_id = ?;

deleteRemoteMessagesFrom:
DELETE FROM remote_session_message WHERE device_key = ? AND session_id = ? AND seq >= ?;

upsertRemoteCursor:
INSERT OR REPLACE INTO remote_session_cursor(device_key, session_id, poll_version, known_message_count, known_model_catalog_version)
VALUES (?, ?, ?, ?, ?);

selectRemoteCursor:
SELECT * FROM remote_session_cursor WHERE device_key = ? AND session_id = ?;

deleteRemoteCursor:
DELETE FROM remote_session_cursor WHERE device_key = ? AND session_id = ?;

selectRemoteWorkspaces:
SELECT * FROM remote_workspace_list WHERE device_key = ? ORDER BY seq ASC;

insertRemoteWorkspace:
INSERT INTO remote_workspace_list(device_key, path, name, last_opened, workspace_kind, seq, workspace_id, remote_connection_id, remote_ssh_host)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteRemoteWorkspacesForDevice:
DELETE FROM remote_workspace_list WHERE device_key = ?;

CREATE TABLE relay_stream_cursor (
    stream TEXT NOT NULL PRIMARY KEY,
    seq INTEGER NOT NULL
);
CREATE TABLE relay_stream_fragment (
    stream TEXT NOT NULL,
    event_id TEXT NOT NULL,
    part_index INTEGER NOT NULL,
    content TEXT NOT NULL,
    PRIMARY KEY (stream, event_id, part_index)
);

relayStreamCursor:
SELECT seq FROM relay_stream_cursor WHERE stream = ?;

relayStreamFragments:
SELECT content FROM relay_stream_fragment WHERE stream = ? AND event_id = ? ORDER BY part_index;

relayStreamCommitCursor:
INSERT OR REPLACE INTO relay_stream_cursor(stream, seq) VALUES (?, ?);

relayStreamCommitFragment:
INSERT OR REPLACE INTO relay_stream_fragment(stream, event_id, part_index, content) VALUES (?, ?, ?, ?);

relayStreamEventIds:
SELECT DISTINCT event_id FROM relay_stream_fragment WHERE stream = ? ORDER BY event_id;
