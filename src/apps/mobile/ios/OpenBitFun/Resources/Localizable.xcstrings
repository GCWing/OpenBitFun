      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenBitFun Desktop"
          }
        }
      }
    },
    "不再询问，允许桌面端执行所有操作。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the desktop to perform all operations without asking."
          }
        }
      }
    },
