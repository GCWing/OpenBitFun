+void PresentOpenBitFunTexture(blink::WebLocalFrame* frame,
+                            const std::string& label,
+                            bool popup,
+                            OpenBitFunTexture* texture) {
+  auto* isolate = frame->GetAgentGroupScheduler()->Isolate();
+  v8::HandleScope handles(isolate);
+  auto context = frame->MainWorldScriptContext();
+  if (context.IsEmpty() || !GetExecutionContext(context)) {
+    return;
+  }
+  v8::Context::Scope context_scope(context);
+  v8::TryCatch try_catch(isolate);
+  v8::Local<v8::Value> callback;
+  if (!context->Global()
+           ->Get(context, v8::String::NewFromUtf8Literal(
+                              isolate, "__openbitfunPresentOsrTexture"))
+           .ToLocal(&callback) ||
+      !callback->IsFunction()) {
+    return;
+  }
+
+  auto present = [&](v8::Local<v8::Value> image) {
+    const gfx::Rect rect = texture ? texture->content_rect : gfx::Rect();
+    const gfx::Point origin = texture ? texture->origin : gfx::Point();
+    v8::Local<v8::Value> args[] = {
+        v8::String::NewFromUtf8(isolate, label.c_str()).ToLocalChecked(),
+        v8::Boolean::New(isolate, popup), image,
+        v8::Integer::New(isolate, rect.x()),
+        v8::Integer::New(isolate, rect.y()),
+        v8::Integer::New(isolate, rect.width()),
+        v8::Integer::New(isolate, rect.height()),
+        v8::Integer::New(isolate, origin.x()),
+        v8::Integer::New(isolate, origin.y()),
+        v8::Number::New(isolate, texture ? texture->scale : 1),
+        v8::Integer::NewFromUnsigned(isolate, texture ? texture->background : 0),
+    };
+    std::ignore = frame->CallFunctionEvenIfScriptDisabled(
+        callback.As<v8::Function>(), context->Global(), std::size(args), args);
+  };
+  if (!texture) {
+    present(v8::Null(isolate));
+    return;
+  }
+
+  // bitmaprenderer would otherwise read the image back in software mode.
+  if (!blink::SharedGpuContext::IsGpuCompositingEnabled()) {
+    present(v8::Undefined(isolate));
+    return;
+  }
+  auto gpu_context = blink::SharedGpuContext::ContextProviderWrapper();
+  auto* sii = gpu_context
+                  ? gpu_context->ContextProvider().SharedImageInterface()
+                  : nullptr;
+  if (!sii || !texture->buffer.io_surface().get()) {
+    present(v8::Undefined(isolate));
+    return;
+  }
+  const auto format = texture->rgba ? viz::SinglePlaneFormat::kRGBA_8888
