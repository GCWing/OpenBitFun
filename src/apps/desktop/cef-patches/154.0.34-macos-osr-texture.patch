+      (format != media::PIXEL_FORMAT_ARGB && format != media::PIXEL_FORMAT_ABGR)) {
+    return;
+  }
+  blink_glue::OpenBitFunTexture texture{
+      std::move(frame->buffer->get_gpu_memory_buffer_handle()),
+      frame->info->color_space, frame->info->coded_size, frame->content_rect,
+      frame->origin, frame->scale, frame->background,
+      format == media::PIXEL_FORMAT_ABGR,
+      base::BindOnce(
+          [](mojo::PendingRemote<viz::mojom::FrameSinkVideoConsumerFrameCallbacks>
+                 lease) {
+            mojo::Remote<viz::mojom::FrameSinkVideoConsumerFrameCallbacks>
+                remote(std::move(lease));
+            remote->Done();
+          },
+          std::move(frame->lease))};
+  blink_glue::PresentOpenBitFunTexture(frame_, label, popup, &texture);
+#endif
+}
