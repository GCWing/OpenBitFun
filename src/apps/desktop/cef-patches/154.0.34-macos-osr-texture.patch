+  }
+  auto* target_impl = static_cast<CefFrameHostImpl*>(target.get());
+  auto* host = target_impl->GetRenderFrameHost();
+  if (!host || !host->IsRenderFrameLive() || !host->IsActive() ||
+      host->GetLastCommittedOrigin().Serialize() != workbench_origin) {
+    return 0;
+  }
+  guest->openbitfun_texture_route = CefBrowserHostBase::OpenBitFunTextureRoute{
+      CefRefPtr<CefFrameHostImpl>(target_impl), host->GetWeakDocumentPtr(),
+      label};
+  return 1;
